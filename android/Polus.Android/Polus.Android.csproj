<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android35.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Polus.Android</RootNamespace>
    <ApplicationTitle>Polus</ApplicationTitle>
    <ApplicationId>com.tvmanisback.poluscompanion</ApplicationId>
    <ApplicationVersion>4</ApplicationVersion>
    <ApplicationDisplayVersion>1.3.0</ApplicationDisplayVersion>
    <AndroidTargetSdkVersion>35</AndroidTargetSdkVersion>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NETSDK1202</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LemonLoader.Core/MelonLoader.Installer.Core.csproj" />
    <EmbeddedResource Include="../Polus.Mod/bin/Release/net6.0/Polus.AndroidMod.dll" LogicalName="Polus.Android.Polus.AndroidMod.dll" />
    <EmbeddedResource Include="../Polus.Mod/bin/Release/net6.0/Polus.RoleCore.dll" LogicalName="Polus.Android.Polus.RoleCore.dll" />
  </ItemGroup>
</Project>
