<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Polus</AssemblyName>
    <RootNamespace>Polus.Patcher</RootNamespace>
    <ApplicationIcon>polus.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ignore arbitrary icon.png files; the app icon is generated from assets/polus-icon.svg. -->
    <None Remove="**/icon.png" />
    <Content Remove="**/icon.png" />
    <EmbeddedResource Remove="**/icon.png" />
    <EmbeddedResource Include="..\Plugin\bin\Release\net6.0\Polus.Plugin.dll" LogicalName="Polus.Plugin.dll" />
    <EmbeddedResource Include="..\Plugin\bin\Release\net6.0\MiraAPI.dll" LogicalName="MiraAPI.dll" />
    <EmbeddedResource Include="..\Plugin\bin\Release\net6.0\Reactor.dll" LogicalName="Reactor.dll" />
    <EmbeddedResource Include="..\RoleCore\bin\Release\net6.0\Polus.RoleCore.dll" LogicalName="Polus.RoleCore.dll" />
    <EmbeddedResource Include="..\..\roles\roles.json" LogicalName="roles.json" />
  </ItemGroup>
</Project>
